{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["crumbsdk_reactnative"],
  "ios": {
    "iosModuleName": "CrumbReactNative"
  },
  "android": {
    "androidNamespace": ["crumbsdk", "reactnative"],
    "androidCxxLibName": "crumbsdk_reactnative"
  },
  "autolinking": {
    "CrumbReactNative": {
      "ios": {
        "language": "swift",
        "implementationClassName": "CrumbReactNative"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "CrumbReactNative"
      }
    }
  },
  "ignorePaths": ["node_modules"]
}
