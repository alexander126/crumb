# Copy this file to .env. The real .env file is ignored by Git.
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Enable these after confirming the BrowserStack plan includes them. They are
# disabled by default so a new/free account can run compatibility coverage.
BROWSERSTACK_NETWORK_LOGS=false
BROWSERSTACK_APP_PROFILING=false

# Apple team used only to build the disposable BrowserStack test artifacts.
APPLE_DEVELOPMENT_TEAM=

# Optional exact BrowserStack device overrides. When omitted, the runner
# selects an available real device for each required OS version.
BROWSERSTACK_IOS_15_DEVICE=
BROWSERSTACK_IOS_CURRENT_DEVICE=
BROWSERSTACK_ANDROID_LEGACY_DEVICE=
BROWSERSTACK_ANDROID_CURRENT_DEVICE=
