{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/source-map-upload/1.0/schema.json",
  "title": "Crumb source-map upload manifest v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "bundle", "source_map"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "app_version",
        "native_build",
        "js_bundle_version"
      ],
      "properties": {
        "platform": { "enum": ["ios", "android"] },
        "app_version": {
          "type": "string",
          "$ref": "#/$defs/identity",
          "maxLength": 64
        },
        "native_build": {
          "type": "string",
          "$ref": "#/$defs/identity",
          "maxLength": 64
        },
        "js_bundle_version": {
          "type": "string",
          "$ref": "#/$defs/identity",
          "maxLength": 128
        }
      }
    },
    "bundle": { "$ref": "#/$defs/artifact" },
    "source_map": { "$ref": "#/$defs/artifact" }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_size", "sha256"],
      "properties": {
        "byte_size": { "type": "integer", "minimum": 1, "maximum": 26214400 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
